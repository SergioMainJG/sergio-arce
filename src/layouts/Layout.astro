---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import profileImage from '~assets/images/me/yosalem.avif';
import { defaultLang, languages, ui, type Lang } from '../i18n/ui';
import { getLang, getPathWithoutLocale, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  title = t('site.title'),
  description = t('site.description'),
  noindex = false,
  image = profileImage,
  imageAlt = t('presentation.img.salem'),
} = Astro.props;

const site = Astro.site ?? Astro.url;
const path = getPathWithoutLocale(Astro.url.pathname);
const locales = Object.keys(languages) as Lang[];
const canonical = new URL(localizePath(lang, path), site).href;
const alternates = locales.map((code) => ({ code, href: new URL(localizePath(code, path), site).href }));
const defaultUrl = new URL(localizePath(defaultLang, path), site).href;

const otherLang = locales.find((code) => code !== lang)!;
const languageHref = localizePath(otherLang, path);

const ogImage = await getImage({
  src: image,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const ogImageUrl = new URL(ogImage.src, site).href;

const person = {
  '@type': 'Person',
  name: 'Sergio Elias Arce Roldán',
  alternateName: 'Sergio Arce',
  jobTitle: t('site.jobTitle'),
  url: new URL(localizePath(lang), site).href,
  image: ogImageUrl,
  sameAs: [
    'https://github.com/SergioMainJG',
    'https://www.instagram.com/mainsolidnestastrotspostgresql/',
    'https://x.com/SNestAstroSolid',
  ],
};

const structuredData = { '@context': 'https://schema.org', ...person };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sergio Elias Arce Roldán" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sergio Arce" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t('site.locale')} />
    {
      alternates
        .filter(({ code }) => code !== lang)
        .map(({ code }) => <meta property="og:locale:alternate" content={ui[code]['site.locale']} />)
    }
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@SNestAstroSolid" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'lofi' && theme !== 'night') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'lofi';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:btn focus:btn-primary"
    >
      {t('site.skip')}
    </a>
    <Navbar languageHref={languageHref} />
    <slot />
    <Footer />
  </body>
</html>
