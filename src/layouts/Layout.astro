---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import profileImage from '../assets/images/yosalem.avif';
import { defaultLang, languages, ui, type Lang } from '../i18n/ui';
import { getLang, getPathWithoutLocale, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date | undefined;
    tags: string[];
  };
  translations?: Partial<Record<Lang, string>>;
  translationFallback?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  title = t('site.title'),
  description = t('site.description'),
  noindex = false,
  image = profileImage,
  imageAlt = t('presentation.img.salem'),
  article,
  translationFallback = '',
} = Astro.props;

const site = Astro.site ?? Astro.url;
const path = getPathWithoutLocale(Astro.url.pathname);
const locales = Object.keys(languages) as Lang[];
const translations =
  Astro.props.translations ?? Object.fromEntries(locales.map((code) => [code, path]));
const canonical = new URL(localizePath(lang, path), site).href;
const alternates = locales.flatMap((code) => {
  const translatedPath = translations[code];
  return translatedPath === undefined
    ? []
    : [{ code, href: new URL(localizePath(code, translatedPath), site).href }];
});
const defaultPath = translations[defaultLang];
const defaultUrl = defaultPath === undefined ? undefined : new URL(localizePath(defaultLang, defaultPath), site).href;

const otherLang = locales.find((code) => code !== lang)!;
const languageHref = localizePath(otherLang, translations[otherLang] ?? translationFallback);

const ogImage = await getImage({
  src: image,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const ogImageUrl = new URL(ogImage.src, site).href;

const person = {
  '@type': 'Person',
  name: 'Sergio Elias Arce Roldán',
  alternateName: 'Sergio Arce',
  jobTitle: t('site.jobTitle'),
  url: new URL(localizePath(lang), site).href,
  image: ogImageUrl,
  sameAs: [
    'https://github.com/SergioMainJG',
    'https://www.instagram.com/mainsolidnestastrotspostgresql/',
    'https://x.com/SNestAstroSolid',
  ],
};

const structuredData = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImageUrl,
      url: canonical,
      inLanguage: lang,
      datePublished: article.publishedTime.toISOString(),
      dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
      keywords: article.tags,
      author: person,
    }
  : { '@context': 'https://schema.org', ...person };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sergio Elias Arce Roldán" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Sergio Arce" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t('site.locale')} />
    {
      alternates
        .filter(({ code }) => code !== lang)
        .map(({ code }) => <meta property="og:locale:alternate" content={ui[code]['site.locale']} />)
    }
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime.toISOString()} />
          {article.modifiedTime && (
            <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
          )}
          <meta property="article:author" content="Sergio Elias Arce Roldán" />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@SNestAstroSolid" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'lofi' && theme !== 'night') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'lofi';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:btn focus:btn-primary"
    >
      {t('site.skip')}
    </a>
    <Navbar languageHref={languageHref} />
    <slot />
    <Footer />
  </body>
</html>
