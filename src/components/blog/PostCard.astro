---
import { Image } from 'astro:assets';
import type { Post } from '../../utils/blog';
import { getPostPath } from '../../utils/blog';
import { getLang, localizePath, useTranslations } from '../../i18n/utils';
import PostMeta from './PostMeta.astro';

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
  eager?: boolean;
}

const { post, headingLevel = 2, eager = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const href = localizePath(lang, getPostPath(post));
const Heading = `h${headingLevel}` as const;
const { title, description, cover, coverAlt, tags } = post.data;
---

<article
  class="card bg-base-100 shadow-md transition-shadow duration-200 hover:shadow-xl focus-within:shadow-xl md:card-side"
>
  {
    cover && (
      <figure class="md:w-2/5 shrink-0">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[320, 480, 640, 960]}
          sizes="(min-width: 768px) 320px, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          class="size-full aspect-video object-cover bg-base-200"
        />
      </figure>
    )
  }
  <div class="card-body">
    <Heading class="card-title text-2xl">
      <a href={href} class="link link-hover after:absolute after:inset-0">{title}</a>
    </Heading>
    <PostMeta post={post} />
    <p>{description}</p>
    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label={t('blog.tags')}>
          {tags.map((tag) => (
            <li class="badge badge-outline">{tag}</li>
          ))}
        </ul>
      )
    }
    <div class="card-actions justify-end">
      <span class="btn btn-primary btn-sm" aria-hidden="true">{t('blog.readMore')}</span>
    </div>
  </div>
</article>
