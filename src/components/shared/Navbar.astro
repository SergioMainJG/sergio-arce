---
import { languages, type Lang, type UiKey } from '../../i18n/ui';
import { getLang, getPathWithoutLocale, localizePath, useTranslations } from '../../i18n/utils';

interface Props {
  /** Same page in the other language; provided by the layout. */
  languageHref: string;
}

const { languageHref } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const path = getPathWithoutLocale(Astro.url.pathname);
const isActive = (target: string) =>
  target === '' ? path === '' : path === target || path.startsWith(`${target}/`);

const links: { path: string; label: UiKey }[] = [
  { path: 'story', label: 'nav.story' },
  { path: 'blog', label: 'nav.blog' },
  { path: 'projects', label: 'nav.projects' },
];

const otherLang = (Object.keys(languages) as Lang[]).find((code) => code !== lang)!;
---

<header class="sticky z-50 top-0">
  <div class="navbar bg-base-100 shadow-md">
    <!-- Botón -->
    <div class="navbar-start">
      <div class="dropdown">
        <div tabindex="0" role="button" class="btn btn-ghost lg:hidden" aria-label={t('nav.menu')}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            aria-hidden="true"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h8m-8 6h16"
            />
          </svg>
        </div>
        <nav aria-label={t('nav.main')}>
        <ul
          tabindex="-1"
          class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow"
        >
          {
            links.map((link) => (
              <li>
                <a
                  href={localizePath(lang, link.path)}
                  aria-current={isActive(link.path) ? 'page' : undefined}
                  class:list={{ 'font-bold underline underline-offset-4 dark:text-accent': isActive(link.path) }}
                >
                  {t(link.label)}
                </a>
              </li>
            ))
          }
        </ul>
        </nav>
      </div>
      <a
        href={localizePath(lang)}
        aria-current={isActive('') ? 'page' : undefined}
        class:list={[
          'btn btn-ghost text-xl transition-colors duration-150 ease-in-out hover:bg-zinc-300 dark:hover:bg-secondary-content',
          { 'font-bold underline underline-offset-4 dark:text-accent': isActive('') },
        ]}
      >
        <span>Sergio Arce</span>
      </a>
    </div>
    <!-- Botón -->
    <!-- Navegación -->
    <nav class="navbar-center hidden lg:flex" aria-label={t('nav.main')}>
      <ul class="menu menu-horizontal px-1">
        {
          links.map((link) => (
            <li>
              <a
                href={localizePath(lang, link.path)}
                aria-current={isActive(link.path) ? 'page' : undefined}
                class:list={{ 'font-bold underline underline-offset-4 dark:text-accent': isActive(link.path) }}
              >
                {t(link.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <!-- Navegación -->
    <div class="navbar-end gap-2">
      <a
        href={languageHref}
        hreflang={otherLang}
        lang={otherLang}
        title={t('nav.language')}
        class="btn btn-ghost font-bold uppercase"
      >
        <span aria-hidden="true">{otherLang}</span>
        <span class="sr-only">{languages[otherLang]}</span>
      </a>
      <label class="swap swap-rotate btn btn-ghost btn-circle" title={t('nav.theme')}>
        <!-- checked = dark theme; state is synced by the script below -->
        <input type="checkbox" role="switch" data-theme-toggle />
        <span class="sr-only">{t('nav.theme')}</span>

        <!-- sun icon -->
        <svg
          class="swap-off h-8 w-8 fill-current"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
        >
          <path
            d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
          />
        </svg>

        <!-- moon icon -->
        <svg
          class="swap-on h-8 w-8 fill-current"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
        >
          <path
            d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"
          />
        </svg>
      </label>
    </div>
  </div>
</header>

<script>
  const DARK = 'night';
  const LIGHT = 'lofi';
  const root = document.documentElement;
  const darkQuery = matchMedia('(prefers-color-scheme: dark)');

  const getStored = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  const applyTheme = (theme: string) => {
    root.dataset['theme'] = theme;
    document.querySelectorAll<HTMLInputElement>('[data-theme-toggle]').forEach((toggle) => {
      toggle.checked = theme === DARK;
    });
  };

  applyTheme(root.dataset['theme'] ?? (darkQuery.matches ? DARK : LIGHT));

  document.querySelectorAll<HTMLInputElement>('[data-theme-toggle]').forEach((toggle) => {
    toggle.addEventListener('change', () => {
      const theme = toggle.checked ? DARK : LIGHT;
      applyTheme(theme);
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    });
  });

  // Follow OS changes until the user picks a theme explicitly.
  darkQuery.addEventListener('change', (event) => {
    if (!getStored()) applyTheme(event.matches ? DARK : LIGHT);
  });
</script>
