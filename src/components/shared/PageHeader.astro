---
import { getLang, localizePath } from '../../i18n/utils';

interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<header class="text-center">
  <h1 class="text-5xl font-bold text-accent">{title}</h1>
  <p class="mt-3 text-lg opacity-80">{intro}</p>
  <nav aria-label="Breadcrumb" class="breadcrumbs mt-4 flex justify-center text-sm">
    <ul>
      <li><a href={localizePath(lang)}>Home</a></li>
      <li aria-current="page">{title}</li>
    </ul>
  </nav>
</header>
