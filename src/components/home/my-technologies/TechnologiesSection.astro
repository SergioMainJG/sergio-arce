---
import type { TechGroup } from '~interfaces/tech';
import TechRotate from './TechRotate.astro';
import { getLang, useTranslations } from '../../../i18n/utils';

interface Props {
  group: TechGroup;
}

const { group } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<section class="flex flex-col md:hidden">
  <h3
    class="text-center text-3xl font-bold capitalize bg-linear-to-r from-yellow-400 to-red-700 bg-clip-text text-transparent"
  >
    {t(group.title)}
  </h3>
  <TechRotate techs={group.techs} />
</section>
