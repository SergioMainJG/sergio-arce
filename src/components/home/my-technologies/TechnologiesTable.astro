---
import type { TechGroup } from '~interfaces/tech';
import TechRotate from './TechRotate.astro';
import { getLang, useTranslations } from '../../../i18n/utils';

interface Props {
  groups: TechGroup[];
}

const { groups } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<table class="hidden md:table table-fixed" aria-labelledby="technologies-title">
  <tbody>
    {
      groups.map((group) => (
        <tr class="bg-inherit transition-colors duration-250 ease-in hover:bg-zinc-300 dark:hover:bg-primary-content">
          <th scope="row" class="text-center">
            <h3 class="text-2xl font-bold capitalize bg-linear-to-r from-yellow-400 to-red-700 bg-clip-text text-transparent">
              {t(group.title)}
            </h3>
          </th>
          <td class="text-center">
            <TechRotate techs={group.techs} />
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
