---
import { Image } from 'astro:assets';
import type { Podcast } from '~interfaces/podcast';
import { getLang, useTranslations } from '../../../i18n/utils';
import devtalles from '../../../assets/images/devtalles.avif';
import lapension from '../../../assets/images/lapension.avif';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const podcasts: Podcast[] = [
  {
    title: 'DevTalles',
    description: {
      es: 'Contenido de desarrollo de software, creado y producido por Fernando Herrera .',
      en: 'Software development content, created and produced by Fernando Herrera.',
    },
    src: devtalles,
    link: 'https://music.youtube.com/watch?v=NdP1hcn_pCs&si=YArTG1KVxxaEOjiW',
  },
  {
    title: 'La Pensión',
    description: {
      es: 'Anecdotas y ocurrencias de cualquier tema, creado y producido por Fedelobo, Criss Martel, y Quenel Ra.',
      en: 'Anecdotes and musings about any topic, created and produced by Fedelobo, Criss Martel, and Quenel Ra.',
    },
    src: lapension,
    link: 'https://music.youtube.com/watch?v=ozCZWuf1Bvk&si=jjf6EIlqZP8vPcqj',
  },
];
---

<article class="w-full" aria-labelledby="podcasts-title">
  <section class="divider divider-info divider-end my-15 w-full">
    <h3
      id="podcasts-title"
      class="text-center text-3xl font-bold bg-linear-to-r from-yellow-400 to-red-700 bg-clip-text text-transparent"
    >
      {t('hobbies.podcasts')}
    </h3>
  </section>

  <ul class="list bg-base-100 rounded-box shadow-md lg:hidden w-full">
    {
      podcasts.map((podcast, index) => (
        <li class="list-row transition-colors duration-200 ease-linear hover:bg-zinc-300">
          <span class="text-4xl font-thin tabular-nums text-content" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <Image format="avif" class="size-10 rounded-box object-cover bg-base-200" src={podcast.src} alt="" width={40} height={40} densities={[1, 2]} />
          </div>
          <div class="list-col-grow justify-items-center items-center">
            <h4 class="font-light">{podcast.title}</h4>
          </div>
          <a
            href={podcast.link}
            target="_blank"
            rel="noopener noreferrer"
            referrerpolicy="no-referrer"
            class="btn btn-ghost max-w-fit"
          >
            <svg aria-hidden="true" class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <g
                stroke-linejoin="round"
                stroke-linecap="round"
                stroke-width="2"
                fill="none"
                stroke="currentColor"
              >
                <path d="M6 3L20 12 6 21 6 3z" />
              </g>
            </svg>

            <span class="text-red-700 dark:text-red-400">YouTube</span>
            <span class="sr-only">: {podcast.title} {t('common.newTab')}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <section
    class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 justify-items-center items-center gap-5"
  >
    {
      podcasts.map((podcast) => (
        <article class="card group bg-base-100 image-full w-80 shadow-info-content transition duration-200 hover:shadow-2xl dark:shadow-zinc-300 dark:hover:shadow-lg">
          <figure>
            <Image format="avif" src={podcast.src} alt={`${t('hobbies.cover')}: ${podcast.title}`} class="object-cover size-80 bg-base-200" width={320} height={320} densities={[1, 2]} />
          </figure>
          <section class="card-body w-fit transition-colors duration-200 group-hover:text-info">
            <h4 class="card-title">{podcast.title}</h4>
            <p>{podcast.description[lang]}</p>
            <div class="card-actions justify-end">
              <a
                href={podcast.link}
                target="_blank"
                rel="noopener noreferrer"
                referrerpolicy="no-referrer"
                class="btn btn-ghost"
              >
                <svg aria-hidden="true" class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <g
                    stroke-linejoin="round"
                    stroke-linecap="round"
                    stroke-width="2"
                    fill="none"
                    stroke="currentColor"
                  >
                    <path d="M6 3L20 12 6 21 6 3z" />
                  </g>
                </svg>
                {t('hobbies.watch')}
                <span class="sr-only">: {podcast.title} {t('common.newTab')}</span>
              </a>
            </div>
          </section>
        </article>
      ))
    }
  </section>
</article>
