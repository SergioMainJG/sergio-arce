---
import { Image } from 'astro:assets';
import { movies } from '~data/movies';
import SectionTitle from '../../shared/SectionTitle.astro';
import { getLang, useTranslations } from '../../../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));

const total = movies.length;
const prevOf = (n: number) => (n === 1 ? total : n - 1);
const nextOf = (n: number) => (n === total ? 1 : n + 1);
---

<article class="w-full" aria-labelledby="movies-title">
  <article class="w-full flex flex-col items-center">
    <SectionTitle id="movies-title" title={t('hobbies.movies')} />

    <section
      class="carousel w-[85%] max-w-sm md:w-full md:max-w-2xl mx-auto rounded-box shadow-2xl"
      aria-roledescription="carousel"
      aria-label={t('carousel.label')}
      data-carousel
    >
      {
        movies.map((movie, index) => {
          const n = index + 1;
          return (
            <div
              id={`slide-${n}`}
              class="carousel-item relative w-full aspect-2/3 bg-base-200"
              role="group"
              aria-roledescription={t('carousel.slide')}
              aria-label={`${n} ${t('carousel.of')} ${total}: ${movie.alt}`}
            >
              <Image
                format="avif"
                src={movie.src}
                alt={movie.alt}
                widths={[384, 672, 1008]}
                sizes="(min-width: 768px) 672px, 85vw"
                class="absolute inset-0 size-full object-cover"
              />

              <div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
                <a
                  href={`#slide-${prevOf(n)}`}
                  class="btn btn-circle btn-sm"
                  aria-label={t('carousel.prev')}
                  data-carousel-nav
                >
                  <span aria-hidden="true">❮</span>
                </a>
                <a
                  href={`#slide-${nextOf(n)}`}
                  class="btn btn-circle btn-sm"
                  aria-label={t('carousel.next')}
                  data-carousel-nav
                >
                  <span aria-hidden="true">❯</span>
                </a>
              </div>
            </div>
          );
        })
      }
    </section>
  </article>
</article>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLAnchorElement>('[data-carousel-nav]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const carousel = link.closest<HTMLElement>('[data-carousel]');
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!carousel || !target) return;

      event.preventDefault();
      carousel.scrollTo({
        left: target.offsetLeft,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    });
  });
</script>
