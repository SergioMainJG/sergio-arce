---
import { bands } from '~data/music';
import { podcasts } from '~data/podcasts';
import MediaShowcase from './MediaShowcase.astro';
import MySports from './MySports.astro';
import MyMoviesShows from './MyMoviesShows.astro';
import { getLang, useTranslations } from '../../../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
---

<section class="flex justify-center" aria-labelledby="hobbies-title">
  <div class="w-9/10 flex flex-col items-center">
    <h2
      id="hobbies-title"
      class="text-4xl text-center font-bold bg-linear-to-r from-blue-300 to-purple-500 bg-clip-text text-transparent md:sr-only"
    >
      {t('hobbies.title')}
    </h2>
    <MediaShowcase id="music-title" title={t('hobbies.music')} items={bands} variant="primary" />
    <MediaShowcase id="podcasts-title" title={t('hobbies.podcasts')} items={podcasts} />
    <MySports />
    <MyMoviesShows />
  </div>
</section>
