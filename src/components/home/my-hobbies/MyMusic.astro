---
import { Image } from 'astro:assets';
import type { Band } from '~interfaces/band';
import { getLang, useTranslations } from '../../../i18n/utils';
import cocteautwins from '../../../assets/images/cocteautwins.avif';
import dogstar from '../../../assets/images/dogstar.avif';
import franksinatra from '../../../assets/images/franksinatra.avif';
import luismiguel from '../../../assets/images/luismiguel.avif';
import mrkitty from '../../../assets/images/mrkitty.avif';
import pavarotti from '../../../assets/images/pavarotti.avif';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const bands: Band[] = [
  {
    title: 'Cocteau Twins',
    description: {
      es: " Pioneros del género 'Dream Pop'. Elizabeth Fraser destacó la banda por su voz, la cuál es capaz de adaptarse a diferentes géneros, tonos, o incluso sonar diferente en la misma cancións",
      en: "Pioneers of the 'Dream Pop' genre. Elizabeth Fraser made the band stand out with her voice, which can adapt to different genres and tones, or even sound different within the same song",
    },
    src: cocteautwins,
    alt: 'Coctea Twins - Elizabeth Fraser',
    link: 'https://music.youtube.com/watch?v=_YH5E59ZeUU&si=GcMSUts7ZX6UXJYT',
  },
  {
    title: 'Dogstar',
    description: {
      es: "Banda de rock alternativo, formada por el 94'. Es conocido por la excelente participación de Robert Mailhouse, Bret Domrose, y Keanu Reeves",
      en: "Alternative rock band formed in '94. Known for the excellent performances of Robert Mailhouse, Bret Domrose, and Keanu Reeves",
    },
    src: dogstar,
    alt: 'Dogstar - Robert, Keanu, Bret',
    link: 'https://music.youtube.com/watch?v=CmjhETYr3Go&si=TbdWFMlb-jLMwB15',
  },
  {
    title: 'Frank Sinatra',
    description: {
      es: 'Baritono popular, interpretaba música pop. Bastante conocido por su actuaciones poderosas y energicas como en "My Way of Life"',
      en: 'Popular baritone who performed pop music. Well known for his powerful and energetic performances, such as in "My Way of Life"',
    },
    src: franksinatra,
    alt: 'Frank Sinatra',
    link: 'https://music.youtube.com/watch?v=X3r7GD0R56s&si=Hmf5oDIvk73Xz-6z',
  },
  {
    title: 'Luis Miguel',
    description: {
      es: 'Cantante mexicano conocido mundialmente por su excelente voz, siendo capaz de adaptarse a cualquier género',
      en: 'Mexican singer known worldwide for his excellent voice, able to adapt to any genre',
    },
    src: luismiguel,
    alt: 'Luis Miguel',
    link: 'https://music.youtube.com/watch?v=FhYdaodY_5I&si=J4799euSKC0tTWOc',
  },
  {
    title: 'Mr. Kitty',
    description: {
      es: 'El más famoso autor del género Synthwave y Darkwave. Música popular en EUA y Europa, conocido especialmente por After Dark',
      en: 'The most famous artist of the Synthwave and Darkwave genres. Popular in the US and Europe, especially known for After Dark',
    },
    src: mrkitty,
    alt: 'Mr Kitty',
    link: 'https://music.youtube.com/watch?v=Cl5Vkd4N03Q&si=2GTL109ExXHku_Ip',
  },
  {
    title: 'Luciano Pavarotti',
    description: {
      es: 'Uno de los cantantes de opera más famosos del siglo XX. "Pienso que una vida dedicada a la música es una vida bellamente empleada, y es a eso a lo que he dedicado la mía"',
      en: 'One of the most famous opera singers of the 20th century. "I think a life in music is a life beautifully spent, and this is what I have devoted my life to"',
    },
    src: pavarotti,
    alt: 'Luciano Pavarotti',
    link: 'https://music.youtube.com/watch?v=S8hQFu3-c8s&si=4PPUWSm2sNKvRM5i',
  },
];
---

<article class="w-full" aria-labelledby="music-title">
  <section class="divider divider-primary divider-end my-15">
    <h3
      id="music-title"
      class="text-center text-3xl font-bold bg-linear-to-r from-yellow-400 to-red-700 bg-clip-text text-transparent"
    >
      {t('hobbies.music')}
    </h3>
  </section>

  <ul class="list bg-base-100 rounded-box shadow-md md:hidden w-full">
    {
      bands.map((band, index) => (
        <li class="list-row transition-colors duration-200 ease-linear hover:bg-zinc-300">
          <div class="text-4xl font-thin tabular-nums text-primary" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
          <div>
            <Image format="avif" class="size-10 rounded-box object-cover bg-base-200" src={band.src} alt="" width={40} height={40} densities={[1, 2]} />
          </div>
          <div class="list-col-grow">
            <h4>{band.title}</h4>
          </div>
          <a
            href={band.link}
            target="_blank"
            rel="noopener noreferrer"
            referrerpolicy="no-referrer"
            class="btn btn-ghost max-w-fit"
          >
            <svg aria-hidden="true" class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <g
                stroke-linejoin="round"
                stroke-linecap="round"
                stroke-width="2"
                fill="none"
                stroke="currentColor"
              >
                <path d="M6 3L20 12 6 21 6 3z" />
              </g>
            </svg>

            <span class="text-red-700 dark:text-red-400">YouTube</span>
            <span class="sr-only">: {band.title} {t('common.newTab')}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <section
    class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 justify-items-center items-center gap-20"
  >
    {
      bands.map((band) => (
        <section class="card group bg-base-100 image-full w-80 shadow-info-content transition duration-200 hover:shadow-2xl dark:shadow-zinc-300 dark:hover:shadow-lg">
          <figure>
            <Image format="avif" src={band.src} alt={band.alt} class="object-cover size-80 bg-base-200" width={320} height={320} densities={[1, 2]} />
          </figure>
          <section class="card-body w-fit transition-colors duration-200 group-hover:text-info">
            <h4 class="card-title">{band.title}</h4>
            <p>{band.description[lang]}</p>
            <div class="card-actions justify-end">
              <a
                href={band.link}
                target="_blank"
                rel="noopener noreferrer"
                referrerpolicy="no-referrer"
                class="btn btn-ghost max-w-fit"
              >
                <svg aria-hidden="true" class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <g
                    stroke-linejoin="round"
                    stroke-linecap="round"
                    stroke-width="2"
                    fill="none"
                    stroke="currentColor"
                  >
                    <path d="M6 3L20 12 6 21 6 3z" />
                  </g>
                </svg>
                {t('hobbies.watch')}
                <span class="sr-only">: {band.title} {t('common.newTab')}</span>
              </a>
            </div>
          </section>
        </section>
      ))
    }
  </section>
</article>
