---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostMeta from '../blog/PostMeta.astro';
import { getPostTranslations, type Post } from '../../utils/blog';
import { languages, type Lang } from '../../i18n/ui';
import { getLang, localizePath, useTranslations } from '../../i18n/utils';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { Content } = await render(post);
const translations = await getPostTranslations(post);
const { title, description, cover, coverAlt, tags, pubDate, updatedDate } = post.data;

const otherTranslations = (Object.keys(translations) as Lang[]).filter((code) => code !== lang);
---

<Layout
  title={`${title} | Sergio Arce`}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
  translations={translations}
  translationFallback="blog"
>
  <main id="main" class="mx-auto w-full max-w-3xl px-4 py-12">
    <nav aria-label={t('blog.heading')} class="mb-8">
      <a href={localizePath(lang, 'blog')} class="link link-hover">
        <span aria-hidden="true">←</span>
        {t('blog.back')}
      </a>
    </nav>

    <article>
      <header class="mb-8 flex flex-col gap-4">
        <h1 class="text-4xl font-bold leading-tight md:text-5xl">{title}</h1>
        <p class="text-lg opacity-80">{description}</p>
        <PostMeta post={post} />
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label={t('blog.tags')}>
              {tags.map((tag) => (
                <li class="badge badge-outline">{tag}</li>
              ))}
            </ul>
          )
        }
        {
          otherTranslations.map((code) => (
            <p class="text-sm">
              <a
                href={localizePath(code, translations[code])}
                hreflang={code}
                lang={code}
                class="link"
              >
                {t('blog.translation')} ({languages[code]})
              </a>
            </p>
          ))
        }
      </header>

      {
        cover && (
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[400, 768, 1200]}
            sizes="(min-width: 768px) 768px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="mb-10 w-full rounded-box object-cover aspect-video bg-base-200"
          />
        )
      }

      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </article>
  </main>
</Layout>
